{
  "name": "@otmc-sw/tester",
  "version": "0.1.13",
  "description": "Modern Playwright wrapper for concise, type-safe API and UI testing.",
  "license": "Apache-2.0",

  "type": "module",

  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",

  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },

  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],

  "sideEffects": false,

  "engines": {
    "node": ">=20"
  },

  "publishConfig": {
    "access": "public"
  },

  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "prepublishOnly": "npm run build",
    "clean": "del /q dist\\* 2>nul || rimraf dist 2>nul || rd /s /q dist 2>nul || true"
  },

  "peerDependencies": {
    "@playwright/test": "^1.61.1"
  },

  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@types/node": "^26.1.2",
    "typescript": "^7.0.2"
  },

  "keywords": [
    "playwright",
    "testing",
    "api",
    "rest",
    "ui",
    "e2e",
    "typescript",
    "automation",
    "otmc"
  ],

  "repository": {
    "type": "git",
    "url": "https://github.com/otmc-sw/tester.git"
  },

  "homepage": "https://github.com/otmc-sw/tester#readme",

  "bugs": {
    "url": "https://github.com/otmc-sw/tester/issues"
  }
}